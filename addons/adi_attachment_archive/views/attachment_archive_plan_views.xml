<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Form view
    ============================================================ -->
    <record id="view_attachment_archive_plan_form" model="ir.ui.view">
        <field name="name">attachment.archive.plan.form</field>
        <field name="model">attachment.archive.plan</field>
        <field name="arch" type="xml">
            <form string="Attachment Archive Plan">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_run_archive" type="object" string="Run Archive Now"
                            invisible="state != 'active'"
                            class="btn-primary"
                            confirm="This will move attachment files to the archive directory. Continue?"/>
                    <button name="action_download_archive" type="object" string="Download Archive (tar.gz)"
                            invisible="attachment_count == 0"/>
                    <button name="action_mark_done" type="object" string="Mark as Done"
                            invisible="state != 'active'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_archived_attachments" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo"
                                   string="Archived Attachments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="archive_folder"
                                   placeholder="e.g. invoices/2026"/>
                            <field name="use_record_subfolder"/>
                        </group>
                        <group>
                            <field name="last_run"/>
                        </group>
                    </group>
                    <group string="Domain Filter">
                        <field name="domain" widget="domain"
                               options="{'model': 'model_name'}"
                               nolabel="1"/>
                        <field name="model_name" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         List view
    ============================================================ -->
    <record id="view_attachment_archive_plan_list" model="ir.ui.view">
        <field name="name">attachment.archive.plan.list</field>
        <field name="model">attachment.archive.plan</field>
        <field name="arch" type="xml">
            <list string="Attachment Archive Plans" decoration-muted="state == 'done'">
                <field name="name"/>
                <field name="model_id"/>
                <field name="archive_folder"/>
                <field name="last_run"/>
                <field name="attachment_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Search view
    ============================================================ -->
    <record id="view_attachment_archive_plan_search" model="ir.ui.view">
        <field name="name">attachment.archive.plan.search</field>
        <field name="model">attachment.archive.plan</field>
        <field name="arch" type="xml">
            <search string="Search Archive Plans">
                <field name="name"/>
                <field name="model_id"/>
                <filter string="Active" name="filter_active" domain="[('state','=','active')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Done" name="filter_done" domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================
         Action
    ============================================================ -->
    <record id="action_attachment_archive_plan" model="ir.actions.act_window">
        <field name="name">Attachment Archive Plans</field>
        <field name="res_model">attachment.archive.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_attachment_archive_plan_search"/>
    </record>

    <!-- ============================================================
         Menu (under Technical → Attachments)
    ============================================================ -->
    <menuitem id="menu_attachment_archive_root"
              name="Attachment Archive"
              parent="base.menu_administration"
              sequence="100"/>

    <menuitem id="menu_attachment_archive_plan"
              name="Archive Plans"
              parent="menu_attachment_archive_root"
              action="action_attachment_archive_plan"
              sequence="10"/>

</odoo>
