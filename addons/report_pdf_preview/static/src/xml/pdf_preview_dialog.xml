<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="report_pdf_preview.PdfPreviewDialog">
        <Dialog size="'fullscreen'" title="dialogTitle" footer="true">
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="downloadPdf">
                    <i class="fa fa-download"/> Download PDF
                </button>
                <button class="btn btn-secondary" t-on-click="props.close">
                    Close
                </button>
            </t>
            <div class="o_pdf_preview_container" style="width: 100%; height: 600px; position: relative;">
                <t t-if="state.isLoading">
                    <div class="text-center p-5">
                        <i class="fa fa-spinner fa-spin fa-3x"/>
                        <p class="mt-3">Loading PDF...</p>
                    </div>
                </t>
                <iframe
                    t-att-src="props.pdfUrl"
                    class="o_pdf_iframe"
                    style="width: 100%; height: 100%; border: none;"
                    t-on-load="onIframeLoad"
                />
            </div>
        </Dialog>
    </t>

</templates>
